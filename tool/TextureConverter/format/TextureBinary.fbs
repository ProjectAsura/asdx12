namespace asdx.res;

struct SubResource
{
    Width       : uint;
    Height      : uint;
    RowPitch    : ulong;
    SlicePitch  : ulong;
    PixelOffset : ulong;
}

table TextureBinary
{
    Version          : uint;
    Dimension        : uint;
    Width            : uint;
    Height           : uint;
    DepthOrArraySize : ushort;
    MipLevels        : ushort;
    Format           : uint;
    SubResources     : [SubResource];
    Texels           : [ubyte];
}

root_type TextureBinary;
