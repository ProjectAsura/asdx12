include "../../../res/format/ResTypes.fbs";

namespace asdx.res;

struct KeyFloat3
{
    Time  : float (key);
    Value : Float3;
}

struct KeyQuaternion
{
    Time  : float (key);
    Value : Quaternion;
}

table MotionTrack
{
    Hash      : ulong (key);
    Positions : [KeyFloat3];
    Rotations : [KeyQuaternion];
    Scalings  : [KeyFloat3];
}

table MotionClip
{
    Hash           : ulong (key);
    Duration       : float;
    TicksPerSecond : float;
    Tracks         : [MotionTrack];
}

table MotionBinary
{
    Version         : uint;
    RootTransform   : Float3x4;
    Clips           : [MotionClip];
    HashTable       : [HashString];
}

root_type MotionBinary;
