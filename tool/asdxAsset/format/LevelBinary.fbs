include "../../../res/format/ResTypes.fbs";

namespace asdx.res;

table ModelInstance
{
    Tag         : string (key);
    Path        : string;
    Position    : Float3;
    Scale       : Float3;
    Rotation    : Quaternion;
}

table PointLight
{
    Position  : Float3;
    Color     : Float3;
    Intensity : float;
    Radius    : float;
}

table SpotLight
{
    Position    : Float3;
    Direction   : Float3;
    Color       : Float3;
    Intensity   : float;
    Radius      : float;
    InnerAngle  : float;
    OuterAngle  : float;
}

table DirectionalLight
{
    Direction : Float3;
    Color     : Float3;
    Intensity : float;
}

table ImageBasedLight
{
    Path      : string;
    Intensity : float;
}

union LightUnion
{
    PointLight,
    SpotLight,
    DirectionalLight,
    ImageBasedLight,
}

table Light
{
    Tag  : string (key);
    data : LightUnion;
}

table Pin
{
    Tag      : string (key);
    Position : Float3;
}

table LevelBinary
{
    Models : [ModelInstance];
    Lights : [Light];
    Pins   : [Pin];
}

root_type LevelBinary;
