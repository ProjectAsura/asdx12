include "../../../res/format/ResTypes.fbs";

namespace asdx.res;

enum AlphaType : ubyte
{
    Opaque,
    Mask,
    Blend,
}

table Bone
{
    Name            : string;
    Parent          : int;
    BindPose        : Float4x4;
    InverseBindPose : Float4x4;
    Children        : [int];
}

table Mesh
{
    Name          : string;
    MaterialId    : uint;
    Positions     : [Float3];
    Normals       : [Float3];
    Tangents      : [Float4];
    Colors        : [Unorm4];
    TexCoords     : [Float2];
    BoneWeights   : [Float4];
    BoneIndices   : [Uint4];
    VertexIndices : [uint];
    BoundSphere   : BoundingSphere;
    BoundBox      : BoundingBox;
}

table Material
{
    Name            : string;
    BaseColorFactor : Float3;
    Alpha           : float;
    OcclusionFactor : float;
    RoughnessFactor : float;
    MetalnessFactor : float;
    Ior             : float;
    EmissiveFactor  : Float3;
    BaseColorMap    : string;
    NormalMap       : string;
    OrmMap          : string;
    EmissiveMap     : string;
    AlphaMode       : AlphaType;
    AlphaCutOff     : float;
}

table ModelBinary
{
    Version          : uint;
    Meshes           : [Mesh];
    Materials        : [Material];
    Bones            : [Bone];
    BoundSphere      : BoundingSphere;
    BoundBox         : BoundingBox;
    RootTransform    : Float4x4;
    InvRootTransform : Float4x4;
}

root_type ModelBinary;
