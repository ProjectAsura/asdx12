include "../../../res/format/ResTypes.fbs";

namespace asdx.res;

table Bone
{
    Hash            : ulong;
    Parent          : int;
    BindPose        : Float3x4;
    InverseBindPose : Float3x4;
    Children        : [int];
}

table Mesh
{
    Hash          : ulong;
    MaterialId    : uint;
    Positions     : [Float3];
    Normals       : [Float3];
    Tangents      : [Float4];
    Colors        : [Unorm4];
    TexCoords     : [Float2];
    BoneWeights   : [Float4];
    BoneIndices   : [Uint4];
    VertexIndices : [uint];
}

struct MeshInstance
{
    Hash      : ulong;
    Transform : Float3x4;
}

table MeshBatch
{
    Meshes      : [uint];
    Instances   : [MeshInstance];
}

table ModelBinary
{
    Version             : uint;
    Meshes              : [Mesh];
    Materials           : [ulong];
    Bones               : [Bone];
    MeshBatches         : [MeshBatch];
    HashTable           : [HashString];
    RootTransform       : Float3x4;
    InvRootTransform    : Float3x4;
}

root_type ModelBinary;
