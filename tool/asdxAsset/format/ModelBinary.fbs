include "../../../res/format/ResTypes.fbs";

namespace asdx.res;

enum AlphaType : ubyte
{
    Opaque,
    Mask,
    Blend,
}

table Bone
{
    Name            : string;
    Parent          : int;
    BindPose        : Float3x4;
    InverseBindPose : Float3x4;
    Children        : [int];
}

table Mesh
{
    Name          : string;
    MaterialId    : uint;
    Positions     : [Float3];
    Normals       : [Float3];
    Tangents      : [Float4];
    Colors        : [Unorm4];
    TexCoords     : [Float2];
    BoneWeights   : [Float4];
    BoneIndices   : [Uint4];
    VertexIndices : [uint];
}

table MeshInstance
{
    Names       : [string];
    Transforms  : [Float3x4];
    Meshes      : [uint];
}

table ModelBinary
{
    Version             : uint;
    Meshes              : [Mesh];
    Materials           : [string];
    Bones               : [Bone];
    MeshInstances       : [MeshInstance];
    RootTransform       : Float3x4;
    InvRootTransform    : Float3x4;
}

root_type ModelBinary;
