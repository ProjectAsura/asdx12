include "../../../res/format/ResTypes.fbs";

namespace asdx.res;

enum AlphaType : ubyte
{
    Opaque,
    Mask,
    Blend,
}

table Bone
{
    Name            : string;
    Parent          : int;
    BindPose        : Float3x4;
    InverseBindPose : Float3x4;
    Children        : [int];
}

table Mesh
{
    Name          : string;
    MaterialId    : uint;
    Positions     : [Float3];
    Normals       : [Float3];
    Tangents      : [Float4];
    Colors        : [Unorm4];
    TexCoords     : [Float2];
    BoneWeights   : [Float4];
    BoneIndices   : [Uint4];
    VertexIndices : [uint];
    BoundSphere   : BoundingSphere;
    BoundBox      : BoundingBox;
}

table Material
{
    Name            : string;
    BaseColorFactor : Float3;
    Alpha           : float;
    OcclusionFactor : float;
    RoughnessFactor : float;
    MetalnessFactor : float;
    Ior             : float;
    EmissiveFactor  : Float3;
    BaseColorMap    : string;
    NormalMap       : string;
    OrmMap          : string;
    EmissiveMap     : string;
    AlphaMode       : AlphaType;
    AlphaCutOff     : float;
    TwoSided        : bool;
}

table ModelBatch
{
    Names       : [string];
    Transforms  : [Float3x4];
    Meshes      : [uint];
    BoundSphere : BoundingSphere;
    BoundBox    : BoundingBox;
}

table ModelBinary
{
    Version             : uint;
    Meshes              : [Mesh];
    Materials           : [Material];
    Bones               : [Bone];
    Batches             : [ModelBatch];
    BoundSphere         : BoundingSphere;
    BoundBox            : BoundingBox;
    TotalInstanceCount  : ulong;
    RootTransform       : Float3x4;
    InvRootTransform    : Float3x4;
}

root_type ModelBinary;
