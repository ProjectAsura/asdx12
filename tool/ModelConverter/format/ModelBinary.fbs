namespace asdx.res;

struct Float2
{
    X : float;
    Y : float;
}

struct Float3
{
    X : float;
    Y : float;
    Z : float;
}

struct Float4
{
    X : float;
    Y : float;
    Z : float;
    W : float;
}

struct Uint4
{
    X : uint;
    Y : uint;
    Z : uint;
    W : uint;
}

struct Unorm4
{
    X : ubyte;
    Y : ubyte;
    Z : ubyte;
    W : ubyte;
}

struct Float4x4
{
    _11 : float;
    _12 : float;
    _13 : float;
    _14 : float;

    _21 : float;
    _22 : float;
    _23 : float;
    _24 : float;

    _31 : float;
    _32 : float;
    _33 : float;
    _34 : float;

    _41 : float;
    _42 : float;
    _43 : float;
    _44 : float;
}

table Bone
{
    Name         : string (key);
    OffsetMatrix : Float4x4;
}

table Mesh
{
    Name          : string;
    MaterialTag   : string;
    Positions     : [Float3];
    Normals       : [Float3];
    Tangents      : [Float4];
    Colors        : [Unorm4];
    TexCoords     : [Float2];
    BoneWeights   : [Float4];
    BoneIndices   : [Uint4];
    VertexIndices : [uint];
}

table ModelBinary
{
    Version          : uint;
    Meshes           : [Mesh];
    Bones            : [Bone];
    RootTransform    : Float4x4;
    InvRootTransform : Float4x4;
}

root_type ModelBinary;
