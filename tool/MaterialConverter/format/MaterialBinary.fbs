include "../../../res/format/ResTypes.fbs";

namespace asdx.res;

enum BlendState : byte
{
    Opaque,
    AlphaBlend,
    Additive,
    Substract,
    Premultiplied,
    Multiply,
    Screen,
}

enum DepthState : byte
{
    ReadWrite,
    ReadOnly,
    WriteOnly,
    None,
}

enum RasterizerState : byte
{
    CullNone,
    CullBack,
    CullFront,
    Wireframe,
}

enum SamplerState : byte
{
    PointWrap,
    PointClamp,
    PointMirror,
    LinearWrap,
    LinearClamp,
    LinearMirror,
    AnisotropicWrap,
    AnisotropicClamp,
    AnisotropicMirror,
}

struct RenderState
{
    Blend      : BlendState;
    Depth      : DepthState;
    Rasterizer : RasterizerState;
}

table MaterialTexture
{
    Path    : string (key);
    Sampler : SamplerState;
}

table MaterialParam
{
    Name   : string (key);
    Offset : uint;
    Size   : uint;
    Data   : [ubyte];
}

table MaterialBuffer
{
    Name       : string (key);
    Size       : uint;
    Params     : [MaterialParam];
}

table MaterialBinary
{
    Version     : uint;
    Name        : string;
    PixelShader : string;
    States      : RenderState;
    Textures    : [MaterialTexture];
    Buffers     : [MaterialBuffer];
}

root_type MaterialBinary;
