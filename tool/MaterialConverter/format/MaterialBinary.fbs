namespace asdx.res;

enum PropertyType : ubyte
{
    Bool,
    S8,
    S16,
    S32,
    S64,
    U8,
    U16,
    U32,
    U64,
    F32,
    F64,
}

table Property
{
    Name     : string;
    Type     : PropertyType;
    Offset   : uint;
    Elements : uint;
}

table Material
{
    Name           : string (key);
    ShaderPath     : string;
    Properties     : [Property];
    Textures       : [string];
    ConstantBuffer : [ubyte];
}

table MaterialBinary
{
    Version   : uint;
    Materials : [Material];
}

root_type MaterialBinary;
