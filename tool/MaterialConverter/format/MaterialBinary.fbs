namespace asdx.res;

enum MaterialBlendType : ubyte
{
    Opaque,
    Masked,
    AlphaBlend,
    Additive,
    Subtract,
    Premultiplied,
    Multiply,
    Screen,
}

enum MaterialCullType : ubyte
{
    None,
    Back,
    Front,
}

enum MaterialDepthType : ubyte
{
    ReadWrite,
    ReadOnly,
    WriteOnly,
    None,
}

enum MaterialDataType : ubyte
{
    Bool,
    Sint,
    Uint,
    Float,
}

table MaterialProperty
{
    Name     : string (key);
    Type     : MaterialDataType;
    Elements : uint;
    Offset   : uint;
    Value    : [ubyte];
}

table MaterialTexture
{
    BindName : string (key);
    Path     : string;
}

table MaterialBinary
{
    Version     : uint;
    Name        : string;
    Blend       : MaterialBlendType;
    Cull        : MaterialCullType;
    Depth       : MaterialDepthType;
    ShaderName  : string;
    BufferSize  : uint;
    Props       : [MaterialProperty];
    Textures    : [MaterialTexture];
}

root_type MaterialBinary;
