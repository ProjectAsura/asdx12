include "../../../res/format/ResTypes.fbs";

namespace asdx.res;

table MaterialTexture
{
    Name    : string (key);
    Path    : string;
}

table MaterialParameter
{
    Name    : string (key);
    Value   : float;
}

table MaterialBinary
{
    Version         : uint;
    Kind            : uint;
    Params          : [MaterialParameter];
    Textures        : [MaterialTexture];
}

root_type MaterialBinary;
