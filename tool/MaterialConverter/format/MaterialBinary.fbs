include "../../../res/format/ResTypes.fbs";

namespace asdx.res;

table Material
{
    BindName     : string (key);
    BaseColorMap : string;
    NormalMap    : string;
    OrmMap       : string;
    EmissiveMap  : string;

    BaseColorFactor : Float3;
    OcclusionFactor : float;
    RoughnessFactor : float;
    MetalnessFactor : float;
    EmissiveFactor  : Float3;
    Ior             : float;
    AlphaThreshold  : float;
}

table MaterialBinary
{
    Version     : uint;
    Materials   : [Material];
}

root_type MaterialBinary;
